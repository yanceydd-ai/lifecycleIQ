# Get your database password from Supabase Dashboard → Project Settings → Database
# Use the "Transaction" (pooler) URL for DATABASE_URL and "Session" (direct) URL for DIRECT_URL

# Pooler connection (port 6543) — for runtime queries
DATABASE_URL="postgresql://postgres.jzwapnonuxcaxylwpsvn:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — for Prisma migrations
DIRECT_URL="postgresql://postgres.jzwapnonuxcaxylwpsvn:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# JWT secret — use a long random string in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
